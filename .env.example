# Application Environment: development | production
ENV=development
SERVER_PORT=8080
HTTP_HOST=0.0.0.0

# PostgreSQL Configuration
# Note: When running Go app locally outside Docker, use localhost:5432.
# When running inside Docker Compose, Compose automatically routes to jasmine-postgres:5432.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=jasmine
DB_URL=postgres://postgres:your_postgres_password_here@localhost:5432/jasmine?sslmode=disable

# Compose volume names. Defaults preserve the current Jasmine Compose volumes.
# Override only after reviewing docs/deployment.md and the server inventory.
# JASMINE_POSTGRES_VOLUME=jasmine_jasmine_postgres_data

# Host port for manual webhook Compose runs; CI uses the Actions variable JASMINE_APP_PORT.
APP_PORT=8081

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Polling works without a public domain. Switch to false only after configuring a real HTTPS webhook.
TELEGRAM_POLLING_MODE=true
TELEGRAM_SECRET_TOKEN=
TELEGRAM_WEBHOOK_URL=
# Required comma-separated numeric Telegram user IDs; empty is rejected.
TELEGRAM_ALLOWED_USER_IDS=123456789
# Owner of a private personality override. With one allowed ID it is inferred.
# Required with multiple allowed IDs when a private jasmine_reply override exists.
JASMINE_OWNER_TELEGRAM_ID=0

# OpenRouter AI (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Reasoning, tools and training
LLM_MAIN=google/gemini-3.8-flash
# Image classification and visual extraction
LLM_PHOTO=google/gemini-3.8-flash
# Final conversational replies in Jasmine's voice
LLM_REPLY=x-ai/grok-4.7

# Optional operator-owned JSON templates; see docs/private-prompts.md.
# Native Go runs: JASMINE_PROMPT_OVERRIDES_FILE=/absolute/private/prompts.json
# Docker overlay: JASMINE_PROMPT_OVERRIDES_HOST_FILE=/absolute/private/prompts.json

# Open Food Facts
OFF_ENABLED=true
